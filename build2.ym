name: Build Android APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

env:
  GODOT_VERSION: "4.3"

jobs:
  export-android:
    runs-on: ubuntu-22.04
    container:
      image: barichello/godot-ci:4.3
    steps:
      - uses: actions/checkout@v4

      - name: Descomprimir proyecto
        run: |
          (unzip -q aether-clash.zip) || (apt-get update && apt-get install -y unzip && unzip -q aether-clash.zip)

      - name: Preparar plantillas
        run: |
          mkdir -p ~/.local/share/godot/export_templates ~/.config/godot
          mv /root/.local/share/godot/export_templates/${GODOT_VERSION}.stable ~/.local/share/godot/export_templates/${GODOT_VERSION}.stable

      - name: Configurar Android
        run: |
          keytool -keyalg RSA -genkeypair -alias androiddebugkey -keypass android -keystore $HOME/debug.keystore -storepass android -dname "CN=Android Debug,O=Android,C=US" -validity 9999 -deststoretype pkcs12
          godot --headless --editor --quit || true
          SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/lib/android-sdk}}"
          JDK="$(dirname $(dirname $(readlink -f $(which javac))))"
          S="$HOME/.config/godot/editor_settings-4.3.tres"
          echo "export/android/android_sdk_path = \"$SDK\"" >> $S
          echo "export/android/java_sdk_path = \"$JDK\"" >> $S
          echo "export/android/debug_keystore = \"$HOME/debug.keystore\"" >> $S
          echo "export/android/debug_keystore_user = \"androiddebugkey\"" >> $S
          echo "export/android/debug_keystore_pass = \"android\"" >> $S

      - name: Importar recursos
        working-directory: aether-clash
        run: godot --headless --verbose --import || true

      - name: Exportar APK
        working-directory: aether-clash
        run: |
          mkdir -p build
          godot --headless --verbose --export-debug "Android" build/aether-clash.apk
          test -f build/aether-clash.apk

      - uses: actions/upload-artifact@v4
        with:
          name: aether-clash-apk
          path: aether-clash/build/aether-clash.apk
